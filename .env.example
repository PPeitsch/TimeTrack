# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/timetrack
# Required in production: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=development-key-change-in-production

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Session cookies over HTTPS only (enable in production behind TLS)
SESSION_COOKIE_SECURE=false

# Demo mode: show the demo credentials on the login page
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=demo

# Max size of imported files, in MB
MAX_UPLOAD_MB=10

# Logging
LOG_LEVEL=DEBUG

# Holiday Provider
# Options: ARGENTINA_WEBSITE, ARGENTINA_API
HOLIDAY_PROVIDER=ARGENTINA_API
HOLIDAYS_BASE_URL="https://www.argentina.gob.ar/jefatura/feriados-nacionales-{year}"
HOLIDAY_API_URL="https://api.argentinadatos.com/v1/feriados/{year}"
# Load a year's holidays automatically the first time it is viewed
HOLIDAY_AUTO_FETCH=true

# Required hours per regular working day
WORKING_HOURS_PER_DAY=8
