#, python-format
msgid "\"Default\" follows the base calendar: %(type)s."
msgstr "\"Por defecto\" sigue el calendario base: %(type)s."

msgid "\"Default\" removes the override; days with logged hours keep them."
msgstr "\"Por defecto\" quita el cambio manual; los días con horas cargadas las conservan."

